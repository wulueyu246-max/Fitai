NODE_ENV=development
PORT=3000

# DashScope uses an OpenAI-compatible client. Never commit the real key.
OPENAI_API_KEY=
# Legacy key name remains supported for existing deployments.
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Primary vision, Look generation, and product aesthetic reranking model.
AI_MODEL=qwen3.7-plus
# Manual rollback only: set AI_MODEL=qwen-vl-plus and restart the server.
# The application never falls back to the legacy model automatically.
AI_TIMEOUT_MS=60000
AI_CONNECT_TIMEOUT_MS=30000
AI_MAX_RETRIES=0
# Proxy use is opt-in. Keep false for a direct DashScope connection.
USE_PROXY=false
# Used only when USE_PROXY=true. Credentials are never returned by /health.
AI_PROXY_URL=
# Keep false while diagnosing provider failures. Set true only when the app
# should return Mock after logging the real provider error.
AI_FALLBACK_ON_ERROR=false
# Set true only when you explicitly want to bypass a configured vision model.
# When no API key is configured or the provider request fails, /outfit
# automatically falls back to Mock and returns fallbackReason.
AI_FORCE_MOCK=false

# Required in production. Use comma-separated exact HTTPS origins.
CORS_ORIGINS=
TRUST_PROXY=false
MAX_IMAGE_BYTES=5242880
MAX_CONCURRENT_AI_REQUESTS=4
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Cloud database and private photo storage. The service-role key belongs only
# on the Node server and must never be exposed through a Flutter dart-define.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=shupi_runtime_state
PHOTO_STORAGE_BUCKET=user-photos

# Optional local development fallbacks. Leave empty in production.
USER_STORE_PATH=
ANALYTICS_STORE_PATH=

# Generate both values with a cryptographically secure secret manager.
ADMIN_ANALYTICS_KEY=
AFFILIATE_POSTBACK_SECRET=

# Product provider. With incomplete Taobao credentials, auto keeps using Mock.
PRODUCT_PROVIDER=auto
PRODUCT_PROVIDER_TIMEOUT_MS=12000
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# Required for the real provider. Never hardcode placement values in source.
TAOBAO_PID=
TAOBAO_ADZONE_ID=
TAOBAO_API_URL=https://eco.taobao.com/router/rest
TAOBAO_CONNECT_TIMEOUT_MS=5000
TAOBAO_MAX_RETRIES=1
TAOBAO_SAMPLE_MATERIAL_ID=28029
